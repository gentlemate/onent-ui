---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Showcase from "../components/Showcase.astro";
---

<StarlightPage
    frontmatter={{
        title: "Theme builder",
        description: "Build your theme and preview it on real interfaces.",
        prev: false,
        next: false,
    }}
    hasSidebar={false}
>
    <Showcase />
</StarlightPage>

<style is:global>
    :root:not([data-has-sidebar]) {
        --sl-content-width: 45rem;
    }

    main:has(.showcase) > .content-panel:first-child {
        display: none;
    }

    main:has(.showcase) > .content-panel + .content-panel {
        border-top: none;
    }

    main:has(.showcase) .sl-container {
        max-width: none;
    }

    @media (min-width: 72rem) {
        :root:not([data-has-sidebar]) .right-sidebar-container:has(.theme-builder-sidebar) {
            flex-shrink: 0;
            width: max(
                var(--sl-sidebar-width),
                calc(var(--sl-sidebar-width) + (100% - 2 * var(--sl-sidebar-width) - var(--sl-content-width)) / 2)
            );
        }
    }
</style>
