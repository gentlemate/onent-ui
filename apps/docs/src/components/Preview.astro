---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

type Props = {
    syncKey?: string;
    stack?: boolean;
    bare?: boolean;
} & ({ code: string; tabs?: never; demo?: never } | { code?: never; tabs: Record<string, string>; demo?: string });

const { syncKey, stack = false, bare = false } = Astro.props;
const tabs = Astro.props.tabs ?? { Code: Astro.props.code! };
const code = tabs[Astro.props.demo ?? Object.keys(tabs)[0]];

const iconPattern = /data-icon="(\w+)"/g;
const iconOptionPattern = /\bicon: (\w+)/g;
const toastPattern = /onclick="(toast\([^"]*\))"/g;

function sourceOf(code: string) {
    const names = [...code.matchAll(iconPattern), ...code.matchAll(iconOptionPattern)].map(([, name]) => name);
    const icons = [...new Set(names)].sort();
    const usesToast = code.includes('onclick="toast(');
    if (!icons.length && !usesToast) return { source: code, lang: "html" };

    const markup = code
        .replace(iconPattern, ".icon=$${$1}")
        .replace(toastPattern, (_, call: string) => `@click=\${() => ${call.replaceAll("'", '"')}}`);
    const template = `html\`
${markup.replace(/^/gm, "    ")}
\`;`;
    const source = icons.length ? `import { ${icons.join(", ")} } from "lucide";\n\n${template}` : template;
    return { source, lang: "js" };
}

const sources = Object.entries(tabs).map(([name, code]) => ({
    name,
    ...sourceOf(code),
}));

const maxLines = 10;
const collapsible = sources.some(({ source }) => source.split("\n").length > maxLines + 5);
---

<div class="preview not-content bg-background text-foreground group relative rounded-[0.5rem] border-[1px] border-(--sl-color-gray-5) font-sans">
    {!bare && (
        <oui-button
            square
            variant="ghost"
            title="Customize theme"
            class="preview-theme absolute top-2 right-2 opacity-0 transition-opacity group-hover:opacity-100"
        >
            <oui-icon data-icon="Palette" size="20" label="Customize theme" />
        </oui-button>
    )}
    <div class="bg-accent absolute -inset-px animate-pulse rounded-[inherit] group-data-ready:hidden motion-reduce:animate-none"></div>
    <div
        class:list={[
            "invisible flex justify-center gap-3 px-6 py-10 group-data-ready:visible",
            stack ? "mx-auto max-w-md flex-col items-stretch" : "flex-wrap items-center",
        ]}
        set:html={code}
    />
</div>
{!bare && (
    <div
        class:list={[
            "preview-code not-content group relative",
            collapsible &&
                "[&_pre]:pb-14 data-collapsed:[&_pre]:max-h-[calc(var(--max-lines)*var(--ec-codeFontSize)*var(--ec-codeLineHt)+2*var(--ec-codePadBlk))] data-collapsed:[&_pre]:overflow-y-hidden data-collapsed:[&_pre]:pb-0",
        ]}
        style={`--max-lines: ${maxLines}`}
        data-collapsed={collapsible || undefined}
    >
        {sources.length > 1 ? (
            <Tabs syncKey={syncKey}>
                {sources.map(({ name, source, lang }) => (
                    <TabItem label={name}>
                        <Code code={source} lang={lang} />
                    </TabItem>
                ))}
            </Tabs>
        ) : (
            <Code code={sources[0].source} lang={sources[0].lang} />
        )}
        {collapsible && (
            <div class="group-data-collapsed:from-(--ec-frm-edBg) absolute inset-x-px bottom-px flex justify-center pb-3 group-data-collapsed:bg-linear-to-t group-data-collapsed:pt-16">
                <oui-button class="preview-code-toggle [--oui-primary-foreground:var(--sl-color-black)] [--oui-primary:var(--sl-color-text-accent)]">
                    Expand code
                </oui-button>
            </div>
        )}
    </div>
)}

<script>
    import { toast, type OuiDrawer } from "onent-ui";
    import { icons } from "lucide";

    Object.assign(window, { toast });

    for (const element of document.querySelectorAll<HTMLElement & { icon?: unknown }>(".preview [data-icon]")) {
        element.icon = icons[element.dataset.icon as keyof typeof icons];
    }

    for (const preview of document.querySelectorAll<HTMLElement>(".preview")) {
        preview.dataset.ready = "";
    }

    for (const button of document.querySelectorAll<HTMLElement>(".preview-theme")) {
        button.addEventListener("click", () => document.querySelector<OuiDrawer>("#theme-drawer")!.show());
    }

    for (const toggle of document.querySelectorAll<HTMLElement>(".preview-code-toggle")) {
        toggle.addEventListener("click", () => {
            const collapsed = toggle.closest(".preview-code")!.toggleAttribute("data-collapsed");
            toggle.textContent = collapsed ? "Expand code" : "Collapse code";
        });
    }
</script>
